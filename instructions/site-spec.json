    "footer"
  ],
  "enabledSections": {
    "hero": true,
    "ticker": true,
    "about": true,
    "banner": true,
    "looks": true,
    "beforeAfter": true,
    "gallery": true,
    "prestations": true,
    "testimonials": true,
    "partners": true,
    "timeline": true,
    "faq": true,
    "practicalInfo": true,
    "contact": true,
    "footer": true
  },
  "variants": {
    "hero": "editorial-split",
    "gallery": "curated-grid",
    "prestations": "menu-list",
    "testimonials": "cards-grid",
    "partners": "brand-showcase"
  },
  "enabledFeatures": {
    "contactForm": true,
    "galleryLightbox": true,
    "glowSlider": true,
    "editorialTabs": true,
    "testimonials": true,
    "faq": true,
    "process": false,
    "practicalInfo": true,
    "partners": true,
    "timeline": true,
    "secondaryCta": true,
    "ticker": true,
    "cookieBanner": true,
    "legalModal": true,
    "offlineIndicator": true,
    "keyboardNav": true,
    "scrollProgress": true,
    "lazyLoading": true,
    "metaSocial": true,
    "structuredData": true,
    "reducedMotion": true,
    "i18n": true,
    "customCursor": false,
    "soundEffects": false,
    "pageTransitions": false
  },
  "theme": {
    "colorScheme": "dark",
    "primaryColor": "#0B0E14",
    "primarySurface": "#121722",
    "primaryLight": "#1B2232",
    "accentColor": "#C67D43",
    "accentHover": "#D98E54",
    "accentGlow": "rgba(198, 125, 67, 0.25)",
    "fontHeading": "'Syne', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "fontBody": "'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "textColor": "#E2E8F0",
    "textMuted": "#94A3B8",
    "surfaceBorder": "rgba(198, 125, 67, 0.18)",
