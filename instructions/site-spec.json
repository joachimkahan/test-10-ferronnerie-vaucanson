  "integrations": {
    "contactForm": {
      "provider": "formsubmit",
      "endpoint": "https://formsubmit.co/contact@ferronnerie-vaucanson.fr",
      "captcha": false
    },
    "map": {
      "provider": "osm",
      "latitude": 45.7828,
      "longitude": 4.8082,
      "zoom": 15
    },
    "analytics": {
      "provider": "none"
    }
  },
  "performance": {
    "lazyLoadOffset": 200,
    "debounceDelay": 150,
    "analyticsConsent": "opt-in"
  },
  "accessibility": {
    "ariaCompliance": "WCAG-2.1-AA",
    "minContrastRatio": 4.5,
    "focusableSelectors": "a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex='-1'])"
  },
  "i18n": {
    "defaultLanguage": "fr",
    "availableLanguages": ["fr", "en"],
    "fallbackLanguage": "fr",
    "storageKey": "webexpress_lang"
  }
